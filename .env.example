# ─────────────────────────────────────────────
# HookLab AI — Environment Variables
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ─────────────────────────────────────────────

# PostgreSQL connection string (required for register / login).
DATABASE_URL="postgresql://postgres:password@localhost:5432/hooklab_ai?schema=public"

# Secret used to sign the JWT session (NextAuth v5 reads AUTH_SECRET).
# Generate one with:  npx auth secret   or   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# ─── AI provider (optional) ──────────────────
# Without any of the values below, /api/generate falls back to the built-in
# mock generator, so the app stays fully usable offline.
# Resolution order: AI_ENDPOINT → GEMINI_API_KEY → OPENAI_API_KEY
AI_ENDPOINT=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
